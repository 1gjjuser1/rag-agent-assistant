# 复制为 .env 后填写真实密钥；不要提交 .env
DASHSCOPE_API_KEY=your_dashscope_api_key

# 默认使用 DashScope 公共兼容端点与公共模型名；
# 若使用私有 MaaS 业务空间/私有模型名，请改成自己的地址与模型名
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_CHAT_MODEL=qwen-plus
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3
DASHSCOPE_ENABLE_THINKING=true

# ---- FastAPI 服务层 ----
# 设置后所有 /v1 接口需要 Authorization: Bearer <token>；留空则开放访问（仅本机调试）
API_AUTH_TOKEN=

# ---- RAG 检索与入库参数（阶段 A 新增，均可选） ----
# 文本切分
CHUNK_SIZE=500
CHUNK_OVERLAP=50
# 最终返回给大模型的片段数
RETRIEVAL_TOP_K=5
# 混合检索时向量与 BM25 各自取回并参与融合的候选数
RETRIEVAL_FUSION_POOL=12
# 相关性门槛：候选片段最高向量相似度低于该值时视为“无相关内容”
RETRIEVAL_RELEVANCE_THRESHOLD=0.3
# MMR 去重重排（true/false）与多样性权重（0~1，越大越看重相关性）
RETRIEVAL_MMR_ENABLED=true
RETRIEVAL_MMR_LAMBDA=0.7
# 多轮对话时是否先用大模型改写追问题
QUERY_REWRITE_ENABLED=true
# 对话历史保留的 token 预算（超出后丢弃更早的消息，防止注意力发散）
HISTORY_MAX_TOKENS=2000
# 检索片段送入大模型的 token 预算（超出后只保留更相关的片段）
RAG_CONTEXT_MAX_TOKENS=2500
# Agent 最多工具调用轮数
AGENT_MAX_STEPS=5
# Embedding 批量大小（DashScope 单次最多 20 条，默认 16 留余量）
EMBEDDING_BATCH_SIZE=16

# 第三方天气 API（Open-Meteo，无需 API Key）
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
